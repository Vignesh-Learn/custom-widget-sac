{
  "eula": "",
  "vendor": "Evora Group",
  "license": "",
  "id": "com.evora.oevstarget",
  "version": "1.0.2",
  "name": "Actual vs Target Rows",
  "newInstancePrefix": "ActualVsTarget",
  "description": "Grouped actual vs target bars with pace-based colors",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-evora-actual-vs-target",
      "url": "https://vignesh-learn.github.io/custom-widget-sac/main.js?v=3",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-evora-actual-vs-target-styling",
      "url": "https://vignesh-learn.github.io/custom-widget-sac/styling.js?v=3",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "widgetTitle": { "type": "string", "default": "Order Entry — Actual vs Target" },
    "debug": { "type": "boolean", "default": false },
    "width": { "type": "integer", "default": 600 },
    "height": { "type": "integer", "default": 500 }
  },
  "methods": {
    "setTitle": {
      "description": "Sets the widget title from a script",
      "parameters": [{ "name": "newTitle", "type": "string", "description": "New title" }],
      "body": "this.widgetTitle = newTitle;"
    },
    "getTitle": {
      "returnType": "string",
      "description": "Returns the widget title",
      "body": "return this.widgetTitle;"
    }
  },
  "events": {},
  "dataBindings": {
    "myDataBinding": {
      "feeds": [
        { "id": "dimensions", "description": "Region first, then Business unit", "type": "dimension" },
        { "id": "measures", "description": "Actual first, then Target", "type": "mainStructureMember" }
      ]
    }
  }
}